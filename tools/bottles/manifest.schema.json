{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kingkaonix/aiaio-runtime/schemas/manifest.schema.json",
  "title": "aiaio runtime bottle manifest",
  "description": "Signed catalog of runtime bottles. Served from the aiaio-runtime repository. The app verifies the Ed25519 signature over the canonical JSON body before trusting any entry.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "manifestVersion", "generatedAt", "bottles", "signature"],
  "properties": {
    "schemaVersion": {
      "const": 1,
      "description": "Manifest schema version. Bump only for breaking changes."
    },
    "manifestVersion": {
      "type": "integer",
      "minimum": 1,
      "description": "Monotonic version. Clients refuse to apply a manifest older than the last accepted one."
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "keyId": {
      "type": "string",
      "description": "Identifier of the Ed25519 key that produced `signature`. Clients pin a key set."
    },
    "bottles": {
      "type": "array",
      "items": { "$ref": "#/$defs/bottle" }
    },
    "blocked": {
      "type": "array",
      "description": "Versions that must never be installed (compromised, revoked, broken).",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "version", "reason"],
        "properties": {
          "id": { "type": "string" },
          "version": { "type": "string" },
          "reason": { "type": "string" }
        }
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["alg", "keyId", "value"],
      "properties": {
        "alg": { "const": "ed25519" },
        "keyId": { "type": "string" },
        "value": {
          "type": "string",
          "contentEncoding": "base64",
          "description": "Ed25519 signature over the canonical JSON serialization of the manifest with `signature` removed."
        }
      }
    }
  },
  "$defs": {
    "bottle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "version",
        "license",
        "sourceUrl",
        "redistributable",
        "platforms",
        "archive"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$",
          "description": "Stable bottle identifier, e.g. `node`, `claude-code`."
        },
        "name": { "type": "string", "minLength": 1 },
        "version": {
          "type": "string",
          "minLength": 1,
          "description": "Exact pinned version. Ranges and `latest` are rejected."
        },
        "license": {
          "type": "string",
          "minLength": 1,
          "description": "SPDX expression, or `NOASSERTION` with a note in `licenseNote`."
        },
        "licenseNote": { "type": "string" },
        "sourceUrl": {
          "type": "string",
          "format": "uri",
          "description": "Official upstream source (repository or release page)."
        },
        "redistributable": {
          "type": "boolean",
          "description": "True only when we are legally cleared to host the archive ourselves. When false, `archive.url` must point at the official distribution URL and the app asks the user for consent."
        },
        "platforms": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["abi", "os"],
            "properties": {
              "os": { "enum": ["android", "linux", "macos", "windows"] },
              "abi": { "enum": ["arm64-v8a", "x86_64", "aarch64", "x86_64", "universal"] },
              "minApi": { "type": "integer", "minimum": 26 },
              "archive": { "$ref": "#/$defs/archive" }
            }
          },
          "description": "Per-platform archive metadata. When a platform omits `archive`, the top-level `archive` applies."
        },
        "archive": { "$ref": "#/$defs/archive" },
        "install": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "stripComponents": { "type": "integer", "minimum": 0, "default": 1 },
            "bin": {
              "type": "array",
              "description": "Paths (relative to the unpacked root) to expose on PATH.",
              "items": { "type": "string", "minLength": 1 }
            },
            "env": {
              "type": "object",
              "additionalProperties": { "type": "string" }
            },
            "healthCheck": {
              "type": "object",
              "additionalProperties": false,
              "required": ["argv"],
              "properties": {
                "argv": { "type": "array", "minItems": 1, "items": { "type": "string" } },
                "expectStdout": { "type": "string" },
                "timeoutMs": { "type": "integer", "minimum": 100 }
              }
            }
          }
        },
        "deps": {
          "type": "array",
          "description": "Other bottle ids that must be installed first (e.g. `node` for npm-based CLIs).",
          "items": { "type": "string" }
        },
        "capabilities": {
          "type": "array",
          "items": {
            "enum": ["exec", "pty", "network", "filesystem-home", "mcp", "browser-login"]
          }
        },
        "notes": { "type": "string" }
      }
    },
    "archive": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "sha256", "size", "format"],
      "properties": {
        "url": { "type": "string", "format": "uri" },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "size": { "type": "integer", "minimum": 1 },
        "format": { "enum": ["tar.zst", "tar.gz", "zip"] },
        "mirrors": {
          "type": "array",
          "items": { "type": "string", "format": "uri" }
        }
      }
    }
  }
}
